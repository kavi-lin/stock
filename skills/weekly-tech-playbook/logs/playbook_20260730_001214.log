{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017Sbv5bKKo79nxVwy4XKhFj","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"\n3\trender.py — Weekly Tech Playbook · sizing + render + validate (0 LLM)\n4\t\n5\tInput : a selections JSON (authored by the LLM step; see SKILL.md schema).\n6\tOutput: Dashboard/playbook.json  (consumed by Dashboard/page-playbook.js)\n7\t        reports/<DATE>_TECH_PLAYBOOK.md  (human-readable, review-ready)\n8\t\n9\tFor each basket it sizes conviction tiers into whole-share positions:\n10\t  shares = round(weight_usd / price), actual_cost = shares * price, leftover cash tracked.\n11\t\n12\tValidation (rc): 0 = pass · 1 = fatal (basket != capital, missing price, <1 pick)\n13\t                 2 = degraded-usable (rounding drift > 2% of capital, missing committee data)\n14\t\n15\tUsage:\n16\t  python3 render.py --selections data/selections_2026-06-22.json\n17\t  python3 render.py --selections data/selections_2026-06-22.json --validate-only\n18\t\"\"\"\n19\timport argparse\n20\timport datetime as _dt\n21\timport json\n22\timport os\n23\timport sys\n24\t\n25\tROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), \"..\", \"..\", \"..\"))\n26\tDASH_JSON = os.path.join(ROOT, \"Dashboard\", \"playbook.json\")\n27\tREPORTS = os.path.join(ROOT, \"reports\")\n28\tDATA_DIR = os.path.join(os.path.dirname(__file__), \"..\", \"data\")\n29\t\n30\tTIER_LABEL = {\"core\": \"核心\", \"standard\": \"標準\", \"light\": \"輕倉/樂透\"}\n31\tTIER_ORDER = {\"core\": 0, \"standard\": 1, \"light\": 2}\n32\t\n33\t\n34\tdef _fmt_usd(x):\n35\t    return f\"${x:,.0f}\"\n36\t\n37\t\n38\tdef size_basket(basket, capital):\n39\t    \"\"\"Return (sized_picks, summary, issues).\"\"\"\n40\t    issues = []\n41\t    picks = basket.get(\"picks\", [])\n42\t    if not picks:\n43\t        issues.append((\"fatal\", \"basket has 0 picks\"))\n44\t        return [], {}, issues\n45\t\n46\t    target_sum = sum(p.get(\"weight_usd\", 0) for p in picks)\n47\t    if round(target_sum) != capital:\n48\t        issues.append((\"fatal\", f\"weights sum to {target_sum:,} != capital {capital:,}\"))\n49\t\n50\t    sized = []\n51\t    actual_total = 0.0\n52\t    theme_alloc = {}\n53\t    for p in picks:\n54\t        price = p.get(\"price\")\n55\t        w = p.get(\"weight_usd\", 0)\n56\t        if not price or price <= 0:\n57\t            issues.append((\"fatal\", f\"{p.get('ticker')} missing/invalid price\"))\n58\t            shares, cost = 0, 0.0\n59\t        else:\n60\t            shares = round(w / price)\n61\t            cost = round(shares * price, 2)\n62\t        actual_total += cost\n63\t        theme_alloc[p.get(\"theme\", \"—\")] = theme_alloc.get(p.get(\"theme\", \"—\"), 0) + w\n64\t        if not p.get(\"committee\"):\n65\t            issues.append((\"degraded\", f\"{p.get('ticker')} no committee verdict\"))\n66\t        sized.append({\n67\t            **p,\n68\t            \"tier_label\": TIER_LABEL.get(p.get(\"tier\"), p.get(\"tier\")),\n69\t            \"shares\": shares,\n70\t            \"actual_cost\": cost,\n71\t            \"weight_pct\": round(w / capital * 100, 1) if capital else 0,\n72\t        })\n73\t\n74\t    sized.sort(key=lambda x: (TIER_ORDER.get(x.get(\"tier\"), 9), -x.get(\"weight_usd\", 0)))\n75\t    drift = abs(actual_total - capital)\n76\t    if drift > capital * 0.02:\n77\t        issues.append((\"degraded\", f\"rounding drift {_fmt_usd(drift)} > 2% of capital\"))\n78\t\n79\t    summary = {\n80\t        \"n_picks\": len(picks),\n81\t        \"target_capital\": capital,\n82\t        \"actual_deployed\": round(actual_total, 2),\n83\t        \"leftover_cash\": round(capital - actual_total, 2),\n84\t        \"theme_allocation\": dict(sorted(theme_alloc.items(), key=lambda kv: -kv[1])),\n85\t        \"tier_breakdown\": {\n86\t            \"core\": sum(1 for p in picks if p.get(\"tier\") == \"core\"),\n87\t            \"standard\": sum(1 for p in picks if p.get(\"tier\") == \"standard\"),\n88\t            \"light\": sum(1 for p in picks if p.get(\"tier\") == \"light\"),\n89\t        },\n90\t    }\n91\t    return sized, summary, issues\n92\t\n93\t\n94\tdef validate_codex_review(review):\n95\t    \"\"\"Validate the independent review without mutating the original baskets.\"\"\"\n96\t    issues = []\n97\t    # The independent review is OPTIONAL — the playbook must render standalone so\n98\t    # the weekly generator never blocks on a second opinion being authored first.\n99\t    # When present, it is validated; when absent, generation proceeds clean.\n100\t    if not review:\n101\t        return []\n102\t\n103\t    for field in (\"label\", \"reviewed_on\", \"review_mode\", \"committee_dependency\", \"dependency_note\", \"verdict\"):\n104\t        if not review.get(field):\n105\t            issues.append((\"fatal\", f\"codex_review missing {field}\"))\n106\t    # Blind-then-reconcile is the anti-anchoring gold standard; only enforce the\n107\t    # blind artifact when that mode is actually claimed — don't degrade by default\n108\t    # (that flagged every non-blind review, including ones that never claimed it).\n109\t    if review.get(\"review_mode\") == \"committee_blind_then_reconcile\" and not review.get(\"blind_artifact\"):\n110\t        issues.append((\"fatal\", \"committee-blind codex_review missing blind_artifact\"))\n111\t\n112\t    notes = review.get(\"comparison_notes\", [])\n113\t    if len(notes) < 3:\n114\t        issues.append((\"fatal\", \"codex_review needs at least 3 comparison_notes\"))\n115\t    for i, item in enumerate(notes):\n116\t        for field in (\"title\", \"original\", \"note\"):\n117\t            if not item.get(field):\n118\t                issues.append((\"fatal\", f\"codex_review comparison_notes[{i}] missing {field}\"))\n119\t\n120\t    allocation = review.get(\"recommended_allocation\", [])\n121\t    if not allocation:\n122\t        issues.append((\"fatal\", \"codex_review missing recommended_allocation\"))\n123\t    total_weight = sum(item.get(\"weight_pct\", 0) for item in allocation)\n124\t    if abs(total_weight - 100) > 0.01:\n125\t        issues.append((\"fatal\", f\"codex_review allocation sums to {total_weight}% != 100%\"))\n126\t    tickers = [item.get(\"ticker\") for item in allocation]\n127\t    if len(tickers) != len(set(tickers)):\n128\t        issues.append((\"fatal\", \"codex_review allocation contains duplicate tickers\"))\n129\t    for i, item in enumerate(allocation):\n130\t        if not item.get(\"ticker\") or not item.get(\"role\") or item.get(\"weight_pct\", 0) <= 0:\n131\t            issues.append((\"fatal\", f\"codex_review recommended_allocation[{i}] is incomplete\"))\n132\t\n133\t    if not review.get(\"execution\"):\n134\t        issues.append((\"fatal\", \"codex_review missing execution rules\"))\n135\t    if len(review.get(\"sources\", [])) < 2:\n136\t        issues.append((\"degraded\", \"codex_review has fewer than 2 sources\"))\n137\t    return issues\n138\t\n139\t\n140\tdef build_payload(sel):\n141\t    capital = sel.get(\"capital_per_basket\", 100000)\n142\t    out_baskets = {}\n143\t    all_issues = []\n144\t    for key, basket in sel.get(\"baskets\", {}).items():\n145\t        sized, summary, issues = size_basket(basket, capital)\n146\t        all_issues += [(key, lvl, msg) for lvl, msg in issues]\n147\t        out_baskets[key] = {\n148\t            \"label_zh\": basket.get(\"label_zh\", key),\n149\t            \"label_en\": basket.get(\"label_en\", key),\n150\t            \"thesis\": basket.get(\"thesis\", \"\"),\n151\t            \"summary\": summary,\n152\t            \"picks\": sized,\n153\t        }\n154\t    all_issues += [(\"codex_review\", lvl, msg) for lvl, msg in validate_codex_review(sel.get(\"codex_review\"))]\n155\t    payload = {\n156\t        \"as_of\": sel.get(\"as_of\"),\n157\t        \"week_label\": sel.get(\"week_label\"),\n158\t        \"capital_per_basket\": capital,\n159\t        \"tier_weights\": sel.get(\"tier_weights\"),\n160\t        \"macro\": sel.get(\"macro\", {}),\n161\t        \"discipline_note\": sel.get(\"discipline_note\", \"\"),\n162\t        \"author\": sel.get(\"author\"),\n163\t        \"codex_review\": sel.get(\"codex_review\"),\n164\t        \"baskets\": out_baskets,\n165\t        \"generated_at\": _dt.datetime.now().isoformat(timespec=\"seconds\"),\n166\t    }\n167\t    return payload, all_issues\n168\t\n169\t\n170\tdef render_md(payload):\n171\t    p = payload\n172\t    L = []\n173\t    L.append(f\"# 下週科技投資方案 — 三籃子 $100k Playbook ({p['as_of']})\\n\")\n174\t    L.append(f\"> **適用週**: {p.get('week_label','')}  |  **每籃資金**: {_fmt_usd(p['capital_per_basket'])}  |  **配重**: 核心 $15k×3 / 標準 $10k×4 / 輕倉 $5k×3\")\n175\t    L.append(f\"> **產出**: weekly-tech-playbook skill · render.py  |  **紀律**: {p.get('discipline_note','')}\\n\")\n176\t\n177\t    m = p.get(\"macro\", {})\n178\t    L.append(\"## 市場背景\\n\")\n179\t    L.append(f\"- **Regime**: {m.get('regime','')} · 建議{m.get('exposure_ceiling','')}\")\n180\t    L.append(f\"- **Breadth**: {m.get('breadth','')} · **Market Top**: {m.get('market_top','')}\")\n181\t    L.append(f\"- **情緒**: {m.get('sentiment','')}\")\n182\t    L.append(f\"- **實質利率**: {m.get('real_rate_10y','')}\")\n183\t    if m.get(\"key_events\"):\n184\t        L.append(f\"- **關鍵事件**: \" + \" · \".join(m[\"key_events\"]))\n185\t    if m.get(\"playbook_logic\"):\n186\t        L.append(f\"\\n> {m['playbook_logic']}\\n\")\n187\t\n188\t    review = p.get(\"codex_review\")\n189\t    if review:\n190\t        L.append(\"\\n---\\n\\n## Codex Review — 原文與建議附註\\n\")\n191\t        L.append(f\"> **複核日期**: {review.get('reviewed_on', '')}  |  **結論**: {review.get('verdict', '')}\\n\")\n192\t        L.append(f\"> **Review mode**: `{review.get('review_mode', '')}`  |  **委員會依賴度**: **{review.get('committee_dependency', '')}**  \"\n193\t                 f\"\\n> {review.get('dependency_note', '')}\\n\")\n194\t        L.append(\"| 主題 | 原報告 | Codex Review 附註 |\")\n195\t        L.append(\"|---|---|---|\")\n196\t        for item in review.get(\"comparison_notes\", []):\n197\t            L.append(f\"| **{item.get('title', '')}** | {item.get('original', '')} | {item.get('note', '')} |\")\n198\t\n199\t        allocation = review.get(\"recommended_allocation\", [])\n200\t        if allocation:\n201\t            L.append(\"\\n### Codex 替代配置\\n\")\n202\t            L.append(\"| 標的 | 配重 | 定位 |\")\n203\t            L.append(\"|---|---:|---|\")\n204\t            for item in allocation:\n205\t                L.append(f\"| **{item.get('ticker', '')}** | {item.get('weight_pct', 0)}% | {item.get('role', '')} |\")\n206\t\n207\t        if review.get(\"execution\"):\n208\t            L.append(\"\\n### 執行紀律\\n\")\n209\t            for item in review[\"execution\"]:\n210\t                L.append(f\"- {item}\")\n211\t\n212\t        if review.get(\"sources\"):\n213\t            links = [f\"[{item.get('label', '')}]({item.get('url', '')})\" for item in review[\"sources\"]]\n214\t            L.append(\"\\n**Codex Review 資料來源**: \" + \" · \".join(links) + \"\\n\")\n215\t\n216\t    for key in [\"conservative\", \"aggressive\", \"hybrid\"]:\n217\t        b = p[\"baskets\"].get(key)\n218\t        if not b:\n219\t            continue\n220\t        s = b[\"summary\"]\n221\t        icon = {\"conservative\": \"🛡️\", \"aggressive\": \"🔥\", \"hybrid\": \"⚖️\"}.get(key, \"\")\n222\t        L.append(f\"\\n---\\n\\n## {icon} {b['label_zh']}籃子 — {_fmt_usd(s['target_capital'])} ({b['label_en']})\\n\")\n223\t        L.append(f\"> {b['thesis']}\\n\")\n224\t        L.append(f\"**部署 {_fmt_usd(s['actual_deployed'])} · 餘現金 {_fmt_usd(s['leftover_cash'])} · \"\n225\t                 f\"{s['n_picks']} 檔 (核心 {s['tier_breakdown']['core']}/標準 {s['tier_breakdown']['standard']}/輕 {s['tier_breakdown']['light']})**\\n\")\n226\t        L.append(\"| 檔 | 配重 | 股數 | 實際成本 | 話題 | 理由 + 數據 | Kill |\")\n227\t        L.append(\"|---|---|---|---|---|---|---|\")\n228\t        for pk in b[\"picks\"]:\n229\t            sleeve = f\" _{pk['sleeve']}_\" if pk.get(\"sleeve\") else \"\"\n230\t            L.append(f\"| **{pk['ticker']}**{sleeve} | {_fmt_usd(pk['weight_usd'])} ({pk['weight_pct']}%) \"\n231\t                     f\"| {pk['shares']} | {_fmt_usd(pk['actual_cost'])} | {pk.get('theme','')} \"\n232\t                     f\"| {pk.get('reason','')}；{pk.get('data','')}{(' · 委員會: '+pk['committee']) if pk.get('committee') else ''} \"\n233\t                     f\"| {pk.get('kill','')} |\")\n234\t\n235\t    L.append(\"\\n---\\n\\n## 📋 下週 LLM 檢討 Scaffold\\n\")\n236\t    L.append(f\"> 進場參考價 = 各檔 price 欄（資料快照日 {p['as_of']}；實際交易前須核對最新成交價）。下週同日抓收盤,逐檔算報酬、籃子報酬 vs SPY、命中率 (上漲檔/10),對照 Kill 欄判斷論點是否被打破。\\n\")\n237\t    L.append(\"| 籃子 | 檔 | 進場參考 | 股數 | Kill 訊號 |\")\n238\t    L.append(\"|---|---|---|---|---|\")\n239\t    for key in [\"conservative\", \"aggressive\", \"hybrid\"]:\n240\t        b = p[\"baskets\"].get(key)\n241\t        if not b:\n242\t            continue\n243\t        for pk in b[\"picks\"]:\n244\t            L.append(f\"| {b['label_zh']} | {pk['ticker']} | {pk['price']} | {pk['shares']} | {pk.get('kill','')} |\")\n245\t    L.append(\"\\n**檢討輸出建議**: 每籃報酬 vs SPY、命中率、被觸發 Kill 的標的、待驗證催化兌現與否、以及「保險 vs 激進 vs 混合 哪個贏 + 為什麼」一段話。\\n\")\n246\t    return \"\\n\".join(L)\n247\t\n248\t\n249\tdef main():\n250\t    ap = argparse.ArgumentParser()\n251\t    ap.add_argument(\"--selections\", required=True)\n252\t    ap.add_argument(\"--validate-only\", action=\"store_true\")\n253\t    args = ap.parse_args()\n254\t\n255\t    with open(args.selections, \"r\", encoding=\"utf-8\") as f:\n256\t        sel = json.load(f)\n257\t\n258\t    payload, issues = build_payload(sel)\n259\t\n260\t    fatal = [i for i in issues if i[1] == \"fatal\"]\n261\t    degraded = [i for i in issues if i[1] == \"degraded\"]\n262\t\n263\t    print(f\"=== render Weekly Tech Playbook {payload['as_of']} ===\")\n264\t    for key in [\"conservative\", \"aggressive\", \"hybrid\"]:\n265\t        b = payload[\"baskets\"].get(key)\n266\t        if not b:\n267\t            continue\n268\t        s = b[\"summary\"]\n269\t        print(f\"  {b['label_zh']:4} {s['n_picks']} 檔 · 部署 {_fmt_usd(s['actual_deployed'])} \"\n270\t              f\"· 餘 {_fmt_usd(s['leftover_cash'])}\")\n271\t    if fatal:\n272\t        print(\"\\nFATAL:\")\n273\t        for k, _l, msg in fatal:\n274\t            print(f\"  [{k}] {msg}\")\n275\t    if degraded:\n276\t        print(f\"\\nDEGRADED ({len(degraded)}): \" + \"; \".join(f\"[{k}] {msg}\" for k, _l, msg in degraded[:8]))\n277\t\n278\t    rc = 1 if fatal else (2 if degraded else 0)\n279\t\n280\t    if args.validate_only:\n281\t        print(f\"\\nvalidate-only rc={rc}\")\n282\t        return rc\n283\t    if fatal:\n284\t        print(f\"\\nrc={rc} — fatal issues, not writing outputs\")\n285\t        return rc\n286\t\n287\t    with open(DASH_JSON, \"w\", encoding=\"utf-8\") as f:\n288\t        json.dump(payload, f, ensure_ascii=False, indent=2)\n289\t    # dated machine snapshot — immutable entry record so review.py can replay a\n290\t    # past week's playbook after Dashboard/playbook.json is overwritten next run.\n291\t    os.makedirs(DATA_DIR, exist_ok=True)\n292\t    snap_path = os.path.join(DATA_DIR, f\"playbook_{payload['as_of']}.json\")\n293\t    with open(snap_path, \"w\", encoding=\"utf-8\") as f:\n294\t        json.dump(payload, f, ensure_ascii=False, indent=2)\n295\t    md_path = os.path.join(REPORTS, f\"{payload['as_of']}_TECH_PLAYBOOK.md\")\n296\t    with open(md_path, \"w\", encoding=\"utf-8\") as f:\n297\t        f.write(render_md(payload))\n298\t\n299\t    print(f\"\\nWrote {DASH_JSON}\")\n300\t    print(f\"Wrote {snap_path}\")\n301\t    print(f\"Wrote {md_path}\")\n302\t    print(f\"rc={rc}\")\n303\t    return rc\n304\t\n305\t\n306\tif __name__ == \"__main__\":\n307\t    raise SystemExit(main())\n308\t"}]},"parent_tool_use_id":null,"session_id":"b62fdcef-9d76-4f26-a236-644562844465","uuid":"b3b8a0fe-6fcd-4230-a068-8bf18f9fefbb","timestamp":"2026-07-29T16:12:45.473Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/kavi/Developer/Claude/Projects/ai-investment-committee/skills/weekly-tech-playbook/scripts/render.py","content":"#!/usr/bin/env python3\n\"\"\"\nrender.py — Weekly Tech Playbook · sizing + render + validate (0 LLM)\n\nInput : a selections JSON (authored by the LLM step; see SKILL.md schema).\nOutput: Dashboard/playbook.json  (consumed by Dashboard/page-playbook.js)\n        reports/<DATE>_TECH_PLAYBOOK.md  (human-readable, review-ready)\n\nFor each basket it sizes conviction tiers into whole-share positions:\n  shares = round(weight_usd / price), actual_cost = shares * price, leftover cash tracked.\n\nValidation (rc): 0 = pass · 1 = fatal (basket != capital, missing price, <1 pick)\n                 2 = degraded-usable (rounding drift > 2% of capital, missing committee data)\n\nUsage:\n  python3 render.py --selections data/selections_2026-06-22.json\n  python3 render.py --selections data/selections_2026-06-22.json --validate-only\n\"\"\"\nimport argparse\nimport datetime as _dt\nimport json\nimport os\nimport sys\n\nROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), \"..\", \"..\", \"..\"))\nDASH_JSON = os.path.join(ROOT, \"Dashboard\", \"playbook.json\")\nREPORTS = os.path.join(ROOT, \"reports\")\nDATA_DIR = os.path.join(os.path.dirname(__file__), \"..\", \"data\")\n\nTIER_LABEL = {\"core\": \"核心\", \"standard\": \"標準\", \"light\": \"輕倉/樂透\"}\nTIER_ORDER = {\"core\": 0, \"standard\": 1, \"light\": 2}\n\n\ndef _fmt_usd(x):\n    return f\"${x:,.0f}\"\n\n\ndef size_basket(basket, capital):\n    \"\"\"Return (sized_picks, summary, issues).\"\"\"\n    issues = []\n    picks = basket.get(\"picks\", [])\n    if not picks:\n        issues.append((\"fatal\", \"basket has 0 picks\"))\n        return [], {}, issues\n\n    target_sum = sum(p.get(\"weight_usd\", 0) for p in picks)\n    if round(target_sum) != capital:\n        issues.append((\"fatal\", f\"weights sum to {target_sum:,} != capital {capital:,}\"))\n\n    sized = []\n    actual_total = 0.0\n    theme_alloc = {}\n    for p in picks:\n        price = p.get(\"price\")\n        w = p.get(\"weight_usd\", 0)\n        if not price or price <= 0:\n            issues.append((\"fatal\", f\"{p.get('ticker')} missing/invalid price\"))\n            shares, cost = 0, 0.0\n        else:\n            shares = round(w / price)\n            cost = round(shares * price, 2)\n        actual_total += cost\n        theme_alloc[p.get(\"theme\", \"—\")] = theme_alloc.get(p.get(\"theme\", \"—\"), 0) + w\n        if not p.get(\"committee\"):\n            issues.append((\"degraded\", f\"{p.get('ticker')} no committee verdict\"))\n        sized.append({\n            **p,\n            \"tier_label\": TIER_LABEL.get(p.get(\"tier\"), p.get(\"tier\")),\n            \"shares\": shares,\n            \"actual_cost\": cost,\n            \"weight_pct\": round(w / capital * 100, 1) if capital else 0,\n        })\n\n    sized.sort(key=lambda x: (TIER_ORDER.get(x.get(\"tier\"), 9), -x.get(\"weight_usd\", 0)))\n    drift = abs(actual_total - capital)\n    if drift > capital * 0.02:\n        issues.append((\"degraded\", f\"rounding drift {_fmt_usd(drift)} > 2% of capital\"))\n\n    summary = {\n        \"n_picks\": len(picks),\n        \"target_capital\": capital,\n        \"actual_deployed\": round(actual_total, 2),\n        \"leftover_cash\": round(capital - actual_total, 2),\n        \"theme_allocation\": dict(sorted(theme_alloc.items(), key=lambda kv: -kv[1])),\n        \"tier_breakdown\": {\n            \"core\": sum(1 for p in picks if p.get(\"tier\") == \"core\"),\n            \"standard\": sum(1 for p in picks if p.get(\"tier\") == \"standard\"),\n            \"light\": sum(1 for p in picks if p.get(\"tier\") == \"light\"),\n        },\n    }\n    return sized, summary, issues\n\n\ndef validate_codex_review(review):\n    \"\"\"Validate the independent review without mutating the original baskets.\"\"\"\n    issues = []\n    # The independent review is OPTIONAL — the playbook must render standalone so\n    # the weekly generator never blocks on a second opinion being authored first.\n    # When present, it is validated; when absent, generation proceeds clean.\n    if not review:\n        return []\n\n    for field in (\"label\", \"reviewed_on\", \"review_mode\", \"committee_dependency\", \"dependency_note\", \"verdict\"):\n        if not review.get(field):\n            issues.append((\"fatal\", f\"codex_review missing {field}\"))\n    # Blind-then-reconcile is the anti-anchoring gold standard; only enforce the\n    # blind artifact when that mode is actually claimed — don't degrade by default\n    # (that flagged every non-blind review, including ones that never claimed it).\n    if review.get(\"review_mode\") == \"committee_blind_then_reconcile\" and not review.get(\"blind_artifact\"):\n        issues.append((\"fatal\", \"committee-blind codex_review missing blind_artifact\"))\n\n    notes = review.get(\"comparison_notes\", [])\n    if len(notes) < 3:\n        issues.append((\"fatal\", \"codex_review needs at least 3 comparison_notes\"))\n    for i, item in enumerate(notes):\n        for field in (\"title\", \"original\", \"note\"):\n            if not item.get(field):\n                issues.append((\"fatal\", f\"codex_review comparison_notes[{i}] missing {field}\"))\n\n    allocation = review.get(\"recommended_allocation\", [])\n    if not allocation:\n        issues.append((\"fatal\", \"codex_review missing recommended_allocation\"))\n    total_weight = sum(item.get(\"weight_pct\", 0) for item in allocation)\n    if abs(total_weight - 100) > 0.01:\n        issues.append((\"fatal\", f\"codex_review allocation sums to {total_weight}% != 100%\"))\n    tickers = [item.get(\"ticker\") for item in allocation]\n    if len(tickers) != len(set(tickers)):\n        issues.append((\"fatal\", \"codex_review allocation contains duplicate tickers\"))\n    for i, item in enumerate(allocation):\n        if not item.get(\"ticker\") or not item.get(\"role\") or item.get(\"weight_pct\", 0) <= 0:\n            issues.append((\"fatal\", f\"codex_review recommended_allocation[{i}] is incomplete\"))\n\n    if not review.get(\"execution\"):\n        issues.append((\"fatal\", \"codex_review missing execution rules\"))\n    if len(review.get(\"sources\", [])) < 2:\n        issues.append((\"degraded\", \"codex_review has fewer than 2 sources\"))\n    return issues\n\n\ndef build_payload(sel):\n    capital = sel.get(\"capital_per_basket\", 100000)\n    out_baskets = {}\n    all_issues = []\n    for key, basket in sel.get(\"baskets\", {}).items():\n        sized, summary, issues = size_basket(basket, capital)\n        all_issues += [(key, lvl, msg) for lvl, msg in issues]\n        out_baskets[key] = {\n            \"label_zh\": basket.get(\"label_zh\", key),\n            \"label_en\": basket.get(\"label_en\", key),\n            \"thesis\": basket.get(\"thesis\", \"\"),\n            \"summary\": summary,\n            \"picks\": sized,\n        }\n    all_issues += [(\"codex_review\", lvl, msg) for lvl, msg in validate_codex_review(sel.get(\"codex_review\"))]\n    payload = {\n        \"as_of\": sel.get(\"as_of\"),\n        \"week_label\": sel.get(\"week_label\"),\n        \"capital_per_basket\": capital,\n        \"tier_weights\": sel.get(\"tier_weights\"),\n        \"macro\": sel.get(\"macro\", {}),\n        \"discipline_note\": sel.get(\"discipline_note\", \"\"),\n        \"author\": sel.get(\"author\"),\n        \"codex_review\": sel.get(\"codex_review\"),\n        \"baskets\": out_baskets,\n        \"generated_at\": _dt.datetime.now().isoformat(timespec=\"seconds\"),\n    }\n    return payload, all_issues\n\n\ndef render_md(payload):\n    p = payload\n    L = []\n    L.append(f\"# 下週科技投資方案 — 三籃子 $100k Playbook ({p['as_of']})\\n\")\n    L.append(f\"> **適用週**: {p.get('week_label','')}  |  **每籃資金**: {_fmt_usd(p['capital_per_basket'])}  |  **配重**: 核心 $15k×3 / 標準 $10k×4 / 輕倉 $5k×3\")\n    L.append(f\"> **產出**: weekly-tech-playbook skill · render.py  |  **紀律**: {p.get('discipline_note','')}\\n\")\n\n    m = p.get(\"macro\", {})\n    L.append(\"## 市場背景\\n\")\n    L.append(f\"- **Regime**: {m.get('regime','')} · 建議{m.get('exposure_ceiling','')}\")\n    L.append(f\"- **Breadth**: {m.get('breadth','')} · **Market Top**: {m.get('market_top','')}\")\n    L.append(f\"- **情緒**: {m.get('sentiment','')}\")\n    L.append(f\"- **實質利率**: {m.get('real_rate_10y','')}\")\n    if m.get(\"key_events\"):\n        L.append(f\"- **關鍵事件**: \" + \" · \".join(m[\"key_events\"]))\n    if m.get(\"playbook_logic\"):\n        L.append(f\"\\n> {m['playbook_logic']}\\n\")\n\n    review = p.get(\"codex_review\")\n    if review:\n        L.append(\"\\n---\\n\\n## Codex Review — 原文與建議附註\\n\")\n        L.append(f\"> **複核日期**: {review.get('reviewed_on', '')}  |  **結論**: {review.get('verdict', '')}\\n\")\n        L.append(f\"> **Review mode**: `{review.get('review_mode', '')}`  |  **委員會依賴度**: **{review.get('committee_dependency', '')}**  \"\n                 f\"\\n> {review.get('dependency_note', '')}\\n\")\n        L.append(\"| 主題 | 原報告 | Codex Review 附註 |\")\n        L.append(\"|---|---|---|\")\n        for item in review.get(\"comparison_notes\", []):\n            L.append(f\"| **{item.get('title', '')}** | {item.get('original', '')} | {item.get('note', '')} |\")\n\n        allocation = review.get(\"recommended_allocation\", [])\n        if allocation:\n            L.append(\"\\n### Codex 替代配置\\n\")\n            L.append(\"| 標的 | 配重 | 定位 |\")\n            L.append(\"|---|---:|---|\")\n            for item in allocation:\n                L.append(f\"| **{item.get('ticker', '')}** | {item.get('weight_pct', 0)}% | {item.get('role', '')} |\")\n\n        if review.get(\"execution\"):\n            L.append(\"\\n### 執行紀律\\n\")\n            for item in review[\"execution\"]:\n                L.append(f\"- {item}\")\n\n        if review.get(\"sources\"):\n            links = [f\"[{item.get('label', '')}]({item.get('url', '')})\" for item in review[\"sources\"]]\n            L.append(\"\\n**Codex Review 資料來源**: \" + \" · \".join(links) + \"\\n\")\n\n    for key in [\"conservative\", \"aggressive\", \"hybrid\"]:\n        b = p[\"baskets\"].get(key)\n        if not b:\n            continue\n        s = b[\"summary\"]\n        icon = {\"conservative\": \"🛡️\", \"aggressive\": \"🔥\", \"hybrid\": \"⚖️\"}.get(key, \"\")\n        L.append(f\"\\n---\\n\\n## {icon} {b['label_zh']}籃子 — {_fmt_usd(s['target_capital'])} ({b['label_en']})\\n\")\n        L.append(f\"> {b['thesis']}\\n\")\n        L.append(f\"**部署 {_fmt_usd(s['actual_deployed'])} · 餘現金 {_fmt_usd(s['leftover_cash'])} · \"\n                 f\"{s['n_picks']} 檔 (核心 {s['tier_breakdown']['core']}/標準 {s['tier_breakdown']['standard']}/輕 {s['tier_breakdown']['light']})**\\n\")\n        L.append(\"| 檔 | 配重 | 股數 | 實際成本 | 話題 | 理由 + 數據 | Kill |\")\n        L.append(\"|---|---|---|---|---|---|---|\")\n        for pk in b[\"picks\"]:\n            sleeve = f\" _{pk['sleeve']}_\" if pk.get(\"sleeve\") else \"\"\n            L.append(f\"| **{pk['ticker']}**{sleeve} | {_fmt_usd(pk['weight_usd'])} ({pk['weight_pct']}%) \"\n                     f\"| {pk['shares']} | {_fmt_usd(pk['actual_cost'])} | {pk.get('theme','')} \"\n                     f\"| {pk.get('reason','')}；{pk.get('data','')}{(' · 委員會: '+pk['committee']) if pk.get('committee') else ''} \"\n                     f\"| {pk.get('kill','')} |\")\n\n    L.append(\"\\n---\\n\\n## 📋 下週 LLM 檢討 Scaffold\\n\")\n    L.append(f\"> 進場參考價 = 各檔 price 欄（資料快照日 {p['as_of']}；實際交易前須核對最新成交價）。下週同日抓收盤,逐檔算報酬、籃子報酬 vs SPY、命中率 (上漲檔/10),對照 Kill 欄判斷論點是否被打破。\\n\")\n    L.append(\"| 籃子 | 檔 | 進場參考 | 股數 | Kill 訊號 |\")\n    L.append(\"|---|---|---|---|---|\")\n    for key in [\"conservative\", \"aggressive\", \"hybrid\"]:\n        b = p[\"baskets\"].get(key)\n        if not b:\n            continue\n        for pk in b[\"picks\"]:\n            L.append(f\"| {b['label_zh']} | {pk['ticker']} | {pk['price']} | {pk['shares']} | {pk.get('kill','')} |\")\n    L.append(\"\\n**檢討輸出建議**: 每籃報酬 vs SPY、命中率、被觸發 Kill 的標的、待驗證催化兌現與否、以及「保險 vs 激進 vs 混合 哪個贏 + 為什麼」一段話。\\n\")\n    return \"\\n\".join(L)\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--selections\", required=True)\n    ap.add_argument(\"--validate-only\", action=\"store_true\")\n    args = ap.parse_args()\n\n    with open(args.selections, \"r\", encoding=\"utf-8\") as f:\n        sel = json.load(f)\n\n    payload, issues = build_payload(sel)\n\n    fatal = [i for i in issues if i[1] == \"fatal\"]\n    degraded = [i for i in issues if i[1] == \"degraded\"]\n\n    print(f\"=== render Weekly Tech Playbook {payload['as_of']} ===\")\n    for key in [\"conservative\", \"aggressive\", \"hybrid\"]:\n        b = payload[\"baskets\"].get(key)\n        if not b:\n            continue\n        s = b[\"summary\"]\n        print(f\"  {b['label_zh']:4} {s['n_picks']} 檔 · 部署 {_fmt_usd(s['actual_deployed'])} \"\n              f\"· 餘 {_fmt_usd(s['leftover_cash'])}\")\n    if fatal:\n        print(\"\\nFATAL:\")\n        for k, _l, msg in fatal:\n            print(f\"  [{k}] {msg}\")\n    if degraded:\n        print(f\"\\nDEGRADED ({len(degraded)}): \" + \"; \".join(f\"[{k}] {msg}\" for k, _l, msg in degraded[:8]))\n\n    rc = 1 if fatal else (2 if degraded else 0)\n\n    if args.validate_only:\n        print(f\"\\nvalidate-only rc={rc}\")\n        return rc\n    if fatal:\n        print(f\"\\nrc={rc} — fatal issues, not writing outputs\")\n        return rc\n\n    with open(DASH_JSON, \"w\", encoding=\"utf-8\") as f:\n        json.dump(payload, f, ensure_ascii=False, indent=2)\n    # dated machine snapshot — immutable entry record so review.py can replay a\n    # past week's playbook after Dashboard/playbook.json is overwritten next run.\n    os.makedirs(DATA_DIR, exist_ok=True)\n    snap_path = os.path.join(DATA_DIR, f\"playbook_{payload['as_of']}.json\")\n    with open(snap_path, \"w\", encoding=\"utf-8\") as f:\n        json.dump(payload, f, ensure_ascii=False, indent=2)\n    md_path = os.path.join(REPORTS, f\"{payload['as_of']}_TECH_PLAYBOOK.md\")\n    with open(md_path, \"w\", encoding=\"utf-8\") as f:\n        f.write(render_md(payload))\n\n    print(f\"\\nWrote {DASH_JSON}\")\n    print(f\"Wrote {snap_path}\")\n    print(f\"Wrote {md_path}\")\n    print(f\"rc={rc}\")\n    return rc\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","numLines":308,"startLine":1,"totalLines":308}}}
