# macOS
.DS_Store
.localized

# User portfolio data (never commit)
positions.json

# Persistent events archive — accumulates daily, regenerable from FMP/Fed feeds
events_archive.json

# Log files with sensitive data — keep structure but ignore actual content
news/news_logs/*.json
news/news_logs/news_events.jsonl
news/news_logs/news_events.jsonl.lock
news/news_logs/event_payloads/
news/news_logs/legacy_digest_backup/
sector/sector_logs/*.json
investment/invest_logs/history.json
investment/invest_logs/*_phase0.json
investment/invest_logs/*_phase0_*.json
investment/invest_logs/*.md
# Phase 1.5 quant artifact（V4.88.0 staged mode）：與 history/phase0 同類的 per-session
# 引擎狀態，可由 --self-assemble 重建。shadow_report 的 FWD_PE_CLAMP 校準讀本機這些檔，
# 不需要入版控（同 history.json 的處理）。
investment/invest_logs/*_pf_quant.json
investment/invest_logs/*.SELFASSEMBLED_RAW.json
# Phase 3 engine artifact（V4.117.0）：validator §5l 拿它比對 export 抄得對不對。
# 每次跑 engine 就重寫，同 skills/*/cache 的性質——是證據不是紀錄。
investment/invest_logs/decision_engine/

# Third-party reference repos (read-only, not part of protocol)
reference/

# Claude Code scheduled task lock (local state)
.claude/scheduled_tasks.lock

# LLM 預算計數器的互斥鎖（0 byte，純本機執行期狀態；計數本體 llm_usage.json 有入版控）
config/llm_usage.lock

# Python bytecode
__pycache__/
*.py[cod]

# Claude CLI stream-json scan logs (large, not source)
investment/scan_logs/
news/scan_logs/
sector/scan_logs/

# Per-skill runtime caches (generated on demand, not source)
skills/*/cache/

# quant-backtest result artifacts (regenerated on demand)
skills/quant-backtest/data/

# Per-skill journal (forward-return tracking, local to each machine)
skills/*/journal/

# Claude Code local settings (machine-specific allowlists)
.claude/settings.local.json

# agy / Antigravity CLI workdir (machine-local)
.antigravitycli/

# Daily FMP / FRED cache snapshots (regenerable from upstream APIs)
.cache_bridge/

# Root-level daemon stderr captures (breadth.err / burry.err / dual.err / …)
/*.err
/*.log

# Governance-file backups written before edits (MAINTENANCE.md §1) — local safety
# copies, the tracked file itself is the record
docs/agent-ops/backups/

# Break News per-item logs + daemon state (auto-written by poller; regenerable)
news/break_news_logs/bn_*.json
news/break_news_logs/_*.json

# Nexus supply-chain LLM output cache (regenerable from supply_chain.py)
nexus/supply_chains/*.yaml
nexus/supply_chain_logs/

# Per-day sector caches (grow daily; historical snapshots may be tracked)
sector/breadth_cache/market_breadth_*.json
sector/breadth_cache/market_breadth_*.md
!sector/breadth_cache/market_breadth_history.json   # rolling aggregate — keep tracked
sector/cache/
sector/ftd_cache/
sector/market_top_cache/

# Shared FMP supplementary cache (24h TTL, regenerable)
skills/_shared/fmp_supp_cache/

# Nexus build provenance logs (per-day; baseline tracked, daily new ones ignored)
scripts/nexus/cache/build_log_*.json

# Forward Expectations calibration index — derived cache of the six fields
# calibration scores, rebuilt from the tracked raw snapshots on demand
investment/invest_logs/forward_expectations_calibration_index.json

# Keep directory structure
!news/news_logs/.gitkeep
!sector/sector_logs/.gitkeep
!investment/invest_logs/.gitkeep

# Narrative Pulse Detector V1.0 — per-ticker cache (regenerable, TTL 4h)
skills/narrative-pulse-detector/cache/

# Per-session NOK image-card review thesis (private analysis, not part of repo history)
reports/2026-05-23_NOK_image_review.md

# launchd pre-market job: secrets + logs (do not commit)
scripts/premarket/premarket_cron.env
logs/premarket_cron/

# X KOL collector runtime state (regenerable) + raw observation log.
# config/x_kol.json (roster + budget) IS tracked; these are per-machine runtime.
config/x_kol_state.json
config/x_kol_handles.json
config/x_kol_usage.json*
news/x_kol_logs/
config/x_kol_analysis_cursor.json
config/x_kol_symbol_identity.json

# 模型跑 protocol 時的暫存輸入（p3/p4 payload）。V4.127.0 起禁止在此放自組腳本。
.codex_protocol_tmp/
