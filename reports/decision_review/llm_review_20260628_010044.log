  c=Counter()\n    for x in decs:\n        if action_class(x) in members: c[vl(x)]+=1\n    h=c.get(\"hit\",0); m=c.get(\"miss\",0); ev=h+m\n    print(f\"{grp:14s} n={sum(c.values()):3d} hit={h} miss={m} miss_rate={m/ev*100:.1f}%\" if ev else grp)\nPY","description":"Action class miss rate analysis"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":923,"cache_read_input_tokens":90181,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":923},"output_tokens":61,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"68f52559-e5d3-48ef-be9c-4f93f69cb12c","uuid":"c3c1b80e-5c7a-432d-b45e-a0e73c40a29b","request_id":"req_011CcU8ftSpXkQpr8MkbHv49"}
