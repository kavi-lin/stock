} miss={c['miss']:3} neut={c['neutral']:3} pend={c['pending']:3} miss_rate={c['miss']/e if e else 0:.0%}\")\n\n# 6. Semis HOLD-miss / CANCEL-miss\nprint(\"\\n=== 6. SEMICONDUCTORS focus ===\")\ndef ind(x):\n    return ((x['tuning_hooks'] or {}).get('sub_industry_heat') or {}).get('ticker_industry')\nsemis=[x for x in dd if ind(x)=='Semiconductors']\nprint(f\"semis deep-dive n={len(semis)}\")\nsemis_hold=[x for x in semis if x['decision_content'].get('final_action')=='HOLD']\nch=Counter(vl(x) for x in semis_hold); e=ch['hit']+ch['miss']\nprint(f\"  Semis HOLD: n={len(semis_hold)} hit={ch['hit']} miss={ch['miss']} miss_rate={ch['miss']/e if e else 0:.0%}\")\nsemis_canc=[x for x in semis if is_cancel(x)]\ncc2=Counter(vl(x) for x in semis_canc); e2=cc2['hit']+cc2['miss']\nprint(f\"  Semis CANCEL: n={len(semis_canc)} hit={cc2['hit']} miss={cc2['miss']} miss_rate={cc2['miss']/e2 if e2 else 0:.0%}\")\n\n# 7. HOLD miss by regime\nprint(\"\\n=== 7. HOLD verdict by regime ===\")\nhold=[x for x in dd if x['decision_content'].get('final_action')=='HOLD']\nbyreg=defaultdict(Counter)\nfor x in hold: byreg[x['decision_content'].get('macro_regime')][vl(x)]+=1\nfor r,c in byreg.items():\n    e=c['hit']+c['miss']\n    print(f\"{str(r):12} n={sum(c.values()):3} hit={c['hit']:2} miss={c['miss']:2} miss_rate={c['miss']/e if e else 0:.0%}\")\n\n# hot_zone_probe presence (Rec 11)\nhzp=[x for x in dd if x['decision_content'].get('hot_zone_probe') or (x.get('verdict') or {}).get('hot_zone_probe')]\nprint(f\"\\nhot_zone_probe tagged decisions: {len(hzp)}\")\n# decisions since 2026-06-07 (Rec 11 applied)\nrecent=[x for x in dd if x['decision_date']>='2026-06-07']\nprint(f\"deep-dive since 2026-06-07 (Rec 11): n={len(recent)}\")\nfor x in recent: print(\"  \",x['decision_date'],x['tickers'],x['decision_content'].get('final_action'),x['decision_content'].get('macro_regime'),vl(x))\nPY\npython3 /tmp/review_stats2.py","description":"Heat, decisive agent, semis, regime, Rec11 stats"},"caller":{"ty