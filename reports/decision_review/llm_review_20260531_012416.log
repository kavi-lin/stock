t macro_delta null\ndef get_md(r):\n    dc=r.get(\"decision_content\") or {}\n    return dc.get(\"macro_delta\")\nmd_null=sum(1 for r in nd if get_md(r) is None)\nprint(f\"\\nRec4 news-digest macro_delta null: {md_null}/{len(nd)} = {md_null/len(nd)*100:.1f}%\")\n\n# Rec 7: sub_industry_heat non-null across ALL decisions\nsih=sum(1 for r in recs if (r.get(\"tuning_hooks\") or {}).get(\"sub_industry_heat\"))\nprint(f\"Rec7 sub_industry_heat non-null (all): {sih}/{len(recs)} = {sih/len(recs)*100:.1f}%\")\n# among deep-dive\nsih_dd=sum(1 for r in dd if (r.get(\"tuning_hooks\") or {}).get(\"sub_industry_heat\"))\nprint(f\"Rec7 sub_industry_heat non-null (deep-dive): {sih_dd}/{len(dd)} = {sih_dd/len(dd)*100:.1f}%\")\nPY","description":"Ledger metric recompute"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6039,"cache_read_input_tokens":60284,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6039},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"1af5cea5-01a8-4392-b2de-391b839d0493","uuid":"402e8915-53fc-4cf9-900b-d22e850cc844","request_id":"req_011CbZ9ZhkPULsFovQrb6sTh"}
