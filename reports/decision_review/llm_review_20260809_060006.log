{"type":"item.completed","item":{"id":"item_12","type":"agent_message","text":"目前 index 比 8/2 多 15 筆；3 筆新 deep-dive 尚未完成窗口，但 8/2 的 4 筆已出現 23–30% 窗口的 provisional miss，因此我會把「全量 verdict」與「window=100 的可定案樣本」分開，避免用未完成窗口推調參。接著會重跑既有 flip-rate helper，並核對 Rec 11 的權威 export 欄。"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"python3 scripts/diff_verdict_flips.py && python3 - <<'PY'\nimport json,statistics\nfrom pathlib import Path\nfrom collections import Counter,defaultdict\nD=json.loads(Path('reports/decision_review/event_index_latest.json').read_text()); ds=D['decisions']; dd=[x for x in ds if x['source']=='deep-dive']\ndef lab(x): return (x.get('verdict') or {}).get('label','n/a')\ndef win(x): return (x.get('reality_at_eval') or {}).get('window_complete_pct')\ndef decided(x): return lab(x) in ('hit','miss')\ndef full(x): return win(x)==100\nprint('\\\\nDD CORE')\nfor name,g in [('all',dd),('win100',[x for x in dd if full(x)]),('win100dec',[x for x in dd if full(x) and decided(x)]),('partial',[x for x in dd if win(x)\"'!=100])]: print(name,len(g),Counter(lab(x) for x in g))\n# Actions (MD stance)\nfor field in ['\"'final_action','final_action_modifier']:\n print('\\\\n',field)\n for a in sorted(set(str(x['decision_content'].get(field)) for x in dd)):\n  g=[x for x in dd if str(x['decision_content'].get(field))==a and full(x) and decided(x)]\n  if g: print(a,len(g),Counter(lab(x) for x in g))\n# Metrics\nfor act in ['STAGED_ENTRY','EXECUTE']:\n g=[x for x in dd if x['decision_content'].get('final_action')==act and full(x) and decided(x)]\n print('action_metric',act,len(g),Counter(lab(x) for x in g))\nprint('action_null',sum(x['decision_content'].get('final_action') is None for x in dd),len(dd))\nmissfull=[x for x in dd if full(x) and lab(x)=='miss']\nprint('miss surface',sum((x.get('verdict') or {}).get('max_drawdown_pct') is not None and (x.get('verdict') or {}).get('max_runup_pct') is not None for x in missfull),len(missfull))\n# heat gap full decided\nfor top in [True,False,None]:\n g=[x for x in dd if full(x) and decided(x) and ((x.get('tuning_hooks') or {}).get('sub_industry_heat') or {}).get('industry_top_30pct') is top]\n print('heat',top,len(g),Counter(lab(x) for x in g),'missrate',round(sum(lab(x)=='miss' for x in g)/len(g)*100,1) if g else None)\nprint('heat_nonnull',sum((x.get('tuning_hooks') or {}).get('sub_industry_heat') is not None for x in dd),len(dd))\n# decisive\nprint('\\\\nDECISIVE win100 decided')\nfor a in sorted(set(str((x.get('tuning_hooks') or {}).get('decisive_agent')) for x in dd)):\n g=[x for x in dd if full(x) and decided(x) and str((x.get('tuning_hooks') or {}).get('decisive_agent'))==a]\n print(a,len(g),Counter(lab(x) for x in g))\n# conservative regime\ncons={'HOLD','CANCEL'}\nprint('\\\\nREGIME conservative win100 decided')\nfor r in sorted(set(str((x.get('tuning_hooks') or {}).get('macro_regime')) for x in dd)):\n g=[x for x in dd if full(x) and decided(x) and x['decision_content'].get('final_action') in cons and str((x.get('tuning_hooks') or {}).get('macro_regime'))==r]\n if g: print(r,len(g),Counter(lab(x) for x in g),round(sum(lab(x)=='miss' for x in g)/len(g)*100,1))\n# score bands\nprint('\\\\nSCORE BANDS win100 decided')\nbands=[(-99,0,'<0'),(0,1,'0-1'),(1,2,'1-2'),(2,99,'>=2')]\nfor lo,hi,n in bands:\n g=[x for x in dd if full(x) and decided(x) and isinstance(x['decision_content'].get('final_score'),(int,float)) and lo<=x['decision_content']['final_score']<hi]\n print(n,len(g),Counter(lab(x) for x in g))\n# repeat ticker >=5 full decided\nprint('\\\\nREPEAT')\nfor t in sorted(set(t for x in dd for t in x.get('tickers',[]))):\n g=[x for x in dd if t in x.get('tickers',[]) and full(x) and decided(x)]\n if len(g)>=5: print(t,len(g),Counter(lab(x) for x in g),[x['decision_id'] for x in g if lab(x)=='miss'][-5:])\n# source full/partial\nprint('\\\\nSOURCE FULL')\nfor s in sorted(set(x['source'] for x in ds)):\n g=[x for x in ds if x['source']==s]; fg=[x for x in g if full(x)]\n print(s,'all',len(g),Counter(lab(x) for x in g),'full',len(fg),Counter(lab(x) for x in fg))\n# news\nng=[x for x in ds if x['source']=='news-digest']; known=[x for x in ng if x['decision_content'].get('macro_delta') is not None]\nstrong=[x for x in ng if isinstance(x['decision_content'].get('macro_delta'),(int,float)) and abs(x['decision_content']['macro_delta'])>.5]\nprint('\\\\nNEWS null',len(ng)-len(known),len(ng),'strong',len(strong),Counter(lab(x) for x in strong),'hit',sum(lab(x)=='hit' for x in ng))\n# weekly counts last weeks\nprint('\\\\nWEEKLY')\nfor s in sorted(set(x['source'] for x in ds)):\n c=Counter()\n for x in ds:\n  if x['source']==s:\n   import datetime\n   dt=datetime.date.fromisoformat(x['decision_date']); y,w,_=dt.isocalendar();c[f'{y}-W{w:02}']+=1\n print(s,{k:c[k] for k in sorted(c) if k>='2026-W28'})\n# evidence ids for prominent buckets\nprint('\\\\nEVIDENCE IDS')\nfor title,pred in [\n ('semis_miss',lambda x: ((x.get('tuning_hooks') or {}).get('sub_industry_heat') or {}).get('ticker_industry')=='Semiconductors' and full(x) and lab(x)=='miss'),\n ('score01_miss',lambda x: full(x) and lab(x)=='miss' and isinstance(x['decision_content'].get('final_score'),(int,float)) and 0<=x['decision_content']['final_score']<1),\n ('bullrisk_cons_miss',lambda x: full(x) and lab(x)=='miss' and x['decision_content'].get('final_action') in cons and (x.get('tuning_hooks') or {}).get('macro_regime') in ('BULL','RISK_ON'))]:\n g=[x for x in dd if pred(x)];print(title,len(g),[x['decision_id'] for x in g[-8:]])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
