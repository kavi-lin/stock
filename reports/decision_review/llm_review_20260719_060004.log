{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_011CdBU825J9V2yY5JjFYhaC","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013zji3uriTPn95A9KHJoST1","name":"Bash","input":{"command":"python3 << 'EOF'\nimport json,collections,statistics\nd=json.load(open('reports/decision_review/event_index_latest.json'))\nD=d['decisions']\n\ndef lab(x):\n    v=x.get('verdict') or {}\n    return v.get('label')\ndef wc(x):\n    return (x.get('reality_at_eval') or {}).get('window_complete_pct')\n\nprint(\"=== 1. verdict by source (all) ===\")\nfor src in sorted(set(x['source'] for x in D)):\n    sub=[x for x in D if x['source']==src]\n    c=collections.Counter(lab(x) for x in sub)\n    print(f\"{src:20s} n={len(sub):4d} \" + \" \".join(f\"{k}={v}\" for k,v in sorted(c.items(),key=lambda t:str(t[0]))))\n\nprint(\"\\n=== 1b. verdict by source, window_complete=100 only ===\")\nfor src in sorted(set(x['source'] for x in D)):\n    sub=[x for x in D if x['source']==src and wc(x)==100]\n    c=collections.Counter(lab(x) for x in sub)\n    dec=c['hit']+c['miss']\n    mr=c['miss']/dec if dec else 0\n    print(f\"{src:20s} n={len(sub):4d} decided={dec:3d} miss_rate={mr:.1%} \" + \" \".join(f\"{k}={v}\" for k,v in sorted(c.items(),key=lambda t:str(t[0]))))\n\nDD=[x for x in D if x['source']=='deep-dive' and wc(x)==100]\nprint(f\"\\n=== deep-dive complete-window n={len(DD)} ===\")\n\n# action buckets\ndef act(x):\n    cc=x['decision_content']\n    return cc.get('final_action_modifier') or cc.get('final_action')\nprint(\"\\n=== 2. deep-dive by final_action ===\")\nbyact=collections.defaultdict(list)\nfor x in DD: byact[act(x)].append(x)\nfor a,v in sorted(byact.items(),key=lambda t:-len(t[1])):\n    c=collections.Counter(lab(y) for y in v); dec=c['hit']+c['miss']\n    print(f\"{str(a):18s} n={len(v):3d} hit={c['hit']:3d} miss={c['miss']:3d} neu={c['neutral']:3d} miss_rate={(c['miss']/dec if dec else 0):.1%}\")\n\nprint(\"\\n=== 3. conservative (HOLD/CANCEL) vs active by regime ===\")\nCONS={'HOLD','CANCEL'}\nbyreg=collections.defaultdict(lambda: collections.Counter())\nfor x in DD:\n    r=(x['tuning_hooks'] or {}).get('macro_regime')\n    a=act(x); l=lab(x)\n    if a in CONS and l in ('hit','miss'): byreg[r][l]+=1\nfor r,c in sorted(byreg.items(),key=lambda t:-(t[1]['hit']+t[1]['miss'])):\n    n=c['hit']+c['miss']\n    print(f\"regime={str(r):12s} cons_decided={n:3d} miss={c['miss']:3d} miss_rate={c['miss']/n:.1%}\")\n\nprint(\"\\n=== 4. decisive_agent ===\")\nbyag=collections.defaultdict(lambda: collections.Counter())\nfor x in DD:\n    ag=(x['tuning_hooks'] or {}).get('decisive_agent')\n    l=lab(x)\n    if l in ('hit','miss'): byag[ag][l]+=1\nfor ag,c in sorted(byag.items(),key=lambda t:-(t[1]['hit']+t[1]['miss'])):\n    n=c['hit']+c['miss']\n    print(f\"{str(ag):15s} decided={n:3d} miss={c['miss']:3d} miss_rate={c['miss']/n:.1%}\")\n\nprint(\"\\n=== 4b. News-decisive split active/conservative ===\")\nnewsd=[x for x in DD if (x['tuning_hooks'] or {}).get('decisive_agent')=='News']\nprint(\"News-decisive total N (all windows):\", len([x for x in D if x['source']=='deep-dive' and (x['tuning_hooks'] or {}).get('decisive_agent')=='News']))\nfor grp,name in ((CONS,'conservative'),(None,'active')):\n    sub=[x for x in newsd if (act(x) in CONS if grp else act(x) not in CONS)]\n    c=collections.Counter(lab(x) for x in sub); n=c['hit']+c['miss']\n    print(f\"  News-{name:13s} decided={n:3d} miss={c['miss']:3d} miss_rate={(c['miss']/n if n else 0):.1%}\")\n\nprint(\"\\n=== 5. score band ===\")\ndef band(s):\n    if s is None: return None\n    if s<0: return '<0'\n    if s<1: return '0-1'\n    if s<2: return '1-2'\n    return '>=2'\nbyb=collections.defaultdict(lambda: collections.Counter())\nfor x in DD:\n    b=band(x['decision_content'].get('final_score')); l=lab(x)\n    if l in ('hit','miss'): byb[b][l]+=1\nfor b in ['<0','0-1','1-2','>=2',None]:\n    c=byb.get(b)\n    if not c: continue\n    n=c['hit']+c['miss']\n    print(f\"score {str(b):5s} decided={n:3d} miss={c['miss']:3d} miss_rate={c['miss']/n:.1%}\")\n\nprint(\"\\n=== 6. agent_score_stdev split within 0-1 band ===\")\nb01=[x for x in DD if band(x['decision_content'].get('final_score'))=='0-1' and lab(x) in ('hit','miss') and (x['tuning_hooks'] or {}).get('agent_score_stdev') is not None]\nif b01:\n    med=statistics.median(x['tuning_hooks']['agent_score_stdev'] for x in b01)\n    lo=[x for x in b01 if x['tuning_hooks']['agent_score_stdev']<=med]\n    hi=[x for x in b01 if x['tuning_hooks']['agent_score_stdev']>med]\n    for nm,g in (('low_stdev',lo),('high_stdev',hi)):\n        c=collections.Counter(lab(x) for x in g); n=len(g)\n        print(f\"  {nm:10s} n={n:3d} miss={c['miss']:3d} miss_rate={c['miss']/n:.1%}  (median stdev={med:.3f})\")\n\nprint(\"\\n=== 7. hot_zone_eval_derived distribution (deep-dive, all) ===\")\nalldd=[x for x in D if x['source']=='deep-dive']\nprint(collections.Counter((x['tuning_hooks'] or {}).get('hot_zone_eval_derived') for x in alldd))\nprint(\"hot_zone_qualifying=True:\", sum(1 for x in alldd if (x['tuning_hooks'] or {}).get('hot_zone_qualifying')))\nprint(\"hot_zone_probe=True:\", sum(1 for x in alldd if x['decision_content'].get('hot_zone_probe')))\nprint(\"post 2026-06-07 decisions:\", len([x for x in alldd if x['decision_date']>'2026-06-07']))\nprint(\"post-0607 eval_derived:\", collections.Counter((x['tuning_hooks'] or {}).get('hot_zone_eval_derived') for x in alldd if x['decision_date']>'2026-06-07'))\nprint(\"post-0607 regime:\", collections.Counter((x['tuning_hooks'] or {}).get('macro_regime') for x in alldd if x['decision_date']>'2026-06-07'))\nEOF","description":"Core pattern statistics"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1578,"cache_read_input_tokens":69608,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1578},"output_tokens":3,"service_ti