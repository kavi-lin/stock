'agent_score_stdev') or 0)>=med]\nprint(\"  low-stdev (consensus weak signal):\", len(lo), mr(lo))\nprint(\"  high-stdev (agent disagreement):\", len(hi), mr(hi))\n\n# macro_regime overall verdict\nprint(\"\\n=== regime x verdict (deep-dive) ===\")\nreg=defaultdict(list)\nfor x in dd: reg[dc(x).get('macro_regime')].append(x)\nfor r,items in sorted(reg.items(),key=lambda kv:-len(kv[1])):\n    print(f\"  {str(r):10} N={len(items):3} {mr(items)}\")\nEOF","description":"News-decisive, agent_score_stdev, regime patterns"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1670,"cache_read_input_tokens":88518,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1670},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"eb51c1a9-8b02-4555-af2f-fce0d15184f8","uuid":"48cda9d4-3900-469c-8e87-c0b0504a3232","request_id":"req_011CcFGgi5duRdZnqFb9FZQE"}
