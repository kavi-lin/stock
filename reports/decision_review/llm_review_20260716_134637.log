dive hit_rate={c['hit']/ev*100:.1f}% (target >=50%)\")\n\n# Rec 9 drawdown non-null on miss\nmiss=[x for x in dd if vl(x)=='miss']\nprint(\"Rec 9  miss with max_drawdown_pct non-null: %d/%d\" % (\n  sum(1 for x in miss if (x['verdict'] or {}).get('max_drawdown_pct') is not None), len(miss)))\nprint(\"Rec 8  rollup buckets:\", len(d['industry_rollup']), \"| ledger_active:\", len(d['adjustment_ledger_active']))\nEOF","description":"Compute remaining ledger metrics"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2929,"cache_read_input_tokens":102261,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2929},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"08df1189-a9ca-4b3e-9a9a-ce6806193f65","uuid":"f3505e62-ab28-4108-a629-836a54e8100a","timestamp":"2026-07-16T20:57:58.985Z","request_id":"req_011Cd6QWDjuV51gMnjPC7ttG"}
