s']/ev*100:.1f}%\")\n\nprint(\"\\n=== Semis conservative miss by decision_date era ===\")\nfor lo,hi,label in [('2026-01-01','2026-06-07','pre-Rec11'),('2026-06-07','2026-07-17','post-Rec11')]:\n    rows=[x for x in cons_semis if lo<=x['decision_date']<hi]\n    c=Counter(vl(x) for x in rows); ev=c['hit']+c['miss']\n    print(f\"  {label}: n={len(rows)} miss={c['miss']} rate={c['miss']/ev*100:.1f}%\" if ev else f\"  {label}: n={len(rows)} (none decided)\")\n\nprint(\"\\n=== decisive_agent / agent_breakdown NULL RATE by month (deep-dive) ===\")\nbym=defaultdict(lambda:[0,0,0])\nfor x in dd:\n    m=x['decision_date'][:7]\n    bym[m][0]+=1\n    if x['tuning_hooks'].get('decisive_agent') is None: bym[m][1]+=1\n    if not x.get('agent_breakdown'): bym[m][2]+=1\nfor m in sorted(bym):\n    n,dn,ab=bym[m]\n    print(f\"  {m}: n={n:3d} decisive_agent_null={dn:3d} ({dn/n*100:4.1f}%)  agent_breakdown_empty={ab:3d} ({ab/n*100:4.1f}%)\")\n\nprint(\"\\n=== hot_zone_eval_derived distribution (deep-dive) ===\")\nprint(\" all:\", Counter(x['tuning_hooks'].get('hot_zone_eval_derived') for x in dd))\npost=[x for x in dd if x['decision_date']>='2026-06-07']\nprint(\" post-Rec11 (>=06-07) n=%d:\"%len(post), Counter(x['tuning_hooks'].get('hot_zone_eval_derived') for x in post))\nprint(\" hot_zone_qualifying post:\", Counter(x['tuning_hooks'].get('hot_zone_qualifying') for x in post))\nprint(\" hot_zone_probe post:\", Counter(x['decision_content'].get('hot_zone_probe') for x in post))\nprint(\" hot_zone_eval (authoritative) post:\", Counter(x['decision_content'].get('hot_zone_eval') for x in post))\nEOF","description":"Investigate Semis sample and instrumentation nulls"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3148,"cache_read_input_tokens":74405,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3148},"output_tokens":3,"service_tier":"standard","inference_geo":