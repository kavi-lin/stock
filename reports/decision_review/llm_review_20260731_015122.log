{s}: {len(a)} since 07-13 → ' + ', '.join(f\"{r['decision_date']}/{','.join(r['tickers'])[:14]}/{lab(r)}\" for r in sorted(a,key=lambda x:x['decision_date'])[:12]))\n\nprint(\"\\n=== suppressed_by_risk_flag economics (all) ===\")\nsup=[r for r in dec if r['source']=='deep-dive' and tk(r).get('hot_zone_eval_derived')=='suppressed_by_risk_flag']\ndsup=[r for r in sup if lab(r) in ('hit','miss')]\nm=[r for r in dsup if lab(r)=='miss']; h=[r for r in dsup if lab(r)=='hit']\nru=[(r['verdict'] or {}).get('max_runup_pct') for r in m]; dw=[(r['verdict'] or {}).get('max_drawdown_pct') for r in m]\nprint(f' N={len(sup)} decided={len(dsup)} miss={len(m)} ({len(m)/len(dsup)*100:.1f}%)')\nprint(f' miss subset: avg_runup={statistics.mean(ru):.2f}% avg_dd={statistics.mean(dw):.2f}% worst_dd={min(dw):.2f}%')\nhd=[(r['verdict'] or {}).get('max_drawdown_pct') for r in h]\nprint(f' hit(correctly suppressed) subset dd: {hd}, avg={statistics.mean(hd):.2f}%')\n\nprint(\"\\n=== thematic-screener / sector-scan splits (win100) ===\")\nfor src in ('thematic-screener','sector-scan'):\n    a=[r for r in W if r['source']==src]\n    x=mr(a); print(f' {src}: n={len(a)} decided={x[1]} miss_rate={round(x[2],1)}%')\n    ks=collections.Counter()\n    for r in a: ks.update((r.get('tuning_hooks') or {}).keys())\n    print('   hooks:', dict(ks))\n\nprint(\"\\n=== industry_rollup: n>=5 buckets ranked by miss_rate ===\")\nfor b in sorted([x for x in d['industry_rollup'] if x['n']>=5], key=lambda x:-x['miss_rate']):\n    print(f\"  {b['industry'][:32]:32s} {b['sector'][:12]:12s} n={b['n']:3d} miss={b['miss_rate']:.3f} avg_miss_ret={b['avg_miss_return_pct']} avg_miss_dd={b['avg_miss_drawdown_pct']} top30={b['industry_top_30pct']}\")\ntot=sum(b['n'] for b in d['industry_rollup']); semi=[b for b in d['industry_rollup'] if b['industry']=='Semiconductors'][0]\nprint(f\"\\n Semis share of rollup: {semi['n']}/{tot} = {semi['n']/tot*100:.1f}%\")\ntech=sum(b['n'] for b in d['industry_rollup'] if b['sector']=='Technology')\nprint(f\" Technology sector share: {tech}/{tot} = {tech/tot*100:.1f}%\")\nEOF","description":"Semis variants, new decisions, suppression economics, rollup ranking"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4833,"cache_read_input_tokens":95848,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4833},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d43acaa3-e256-4544-b2cb-dda26d4b5a89","uuid":"c317555a-9373-46c1-bed7-af5f59ccdc35","timestamp":"2026-07-30T17:56:48.641Z","request_id":"req_011CdYfzKChBRt8KqQipGg82"}
