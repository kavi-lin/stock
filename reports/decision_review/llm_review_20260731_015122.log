'CANCEL'])} decided={mr(pop['CANCEL'])[1]} miss={mr(pop['CANCEL'])[0]} = {mr(pop['CANCEL'])[2]:.1f}%\")\nprint(f\"coverage of true population: {len(ic)}/{len(pop['CANCEL'])} = {len(ic)/len(pop['CANCEL'])*100:.1f}%\")\n\ncm=[r for r in pop['CANCEL'] if lab(r)=='miss']\nru=[(r['verdict'] or {}).get('max_runup_pct') for r in cm]\ndw=[(r['verdict'] or {}).get('max_drawdown_pct') for r in cm]\nru=[v for v in ru if v is not None]; dw=[v for v in dw if v is not None]\nprint(f\"\\ntrue-CANCEL miss economics: N={len(cm)} avg_runup={statistics.mean(ru):.2f}% avg_dd={statistics.mean(dw):.2f}% worst_dd={min(dw):.2f}%\")\nch=[r for r in pop['CANCEL'] if lab(r)=='hit']\ndwh=[(r['verdict'] or {}).get('max_drawdown_pct') for r in ch]\ndwh=[v for v in dwh if v is not None]\nprint(f\"true-CANCEL hit (correctly avoided): N={len(ch)} avg_dd={statistics.mean(dwh):.2f}% worst_dd={min(dwh):.2f}%\")\n\nsc=[r for r in pop['CANCEL'] if tkh(r).get('ticker_industry')=='Semiconductors']\nx=mr(sc); print(f\"\\ntrue-CANCEL ∩ Semiconductors: n={len(sc)} miss {x[0]}/{x[1]} = {x[2]:.1f}%\")\nt30=[r for r in pop['CANCEL'] if tkh(r).get('industry_top_30pct') is True]\nn30=[r for r in pop['CANCEL'] if tkh(r).get('industry_top_30pct') is False]\na=mr(t30); b=mr(n30)\nprint(f\"true-CANCEL top30: miss {a[0]}/{a[1]} = {a[2]:.1f}%   not30: miss {b[0]}/{b[1]} = {b[2]:.1f}%  gap={a[2]-b[2]:.1f}pp\")\nprint(\"\\ntrue-CANCEL by regime:\")\nfor rg,c in collections.Counter(str((r.get('tuning_hooks') or {}).get('macro_regime')) for r in pop['CANCEL']).most_common():\n    s=[r for r in pop['CANCEL'] if str((r.get('tuning_hooks') or {}).get('macro_regime'))==rg]\n    x=mr(s); print(f\"  {rg:10s} n={c:3d} miss {x[0]}/{x[1]} = {x[2]:.1f}%\")\nprint(\"\\ntrue-CANCEL by index stance (what the MD called it):\")\nfor st,c in collections.Counter(eff(r) for r in pop['CANCEL']).most_common():\n    s=[r for r in pop['CANCEL'] if eff(r)==st]; x=mr(s)\n    print(f\"  {st:14s} n={c:3d} miss {x[0]}/{x[1]} = {x[2]:.1f}%\")\nEOF","