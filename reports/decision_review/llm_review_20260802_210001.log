(nd):.1f}%  (null {100*(len(nd)-nn)/len(nd):.1f}%)\")\nstrong=[r for r in nd if isinstance(dc(r,'macro_delta'),(int,float)) and abs(dc(r,'macro_delta'))>0.5]\nprint(f\"  strong |delta|>0.5 N={len(strong)}: \"+str(collections.Counter(v(r) for r in strong)))\nprint(f\"  all verdicts: {dict(collections.Counter(v(r) for r in nd))}\")\n\nprint(\"\\n=== N. momentum-screen (TODO-003) ===\")\nms=[r for r in dec if r['source']=='momentum-screen']\nprint(f\"  n={len(ms)} verdicts={dict(collections.Counter(v(r) for r in ms))}\")\nprint(f\"  latest decision_date: {max(r['decision_date'] for r in ms)}\")\nEOF"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2086,"cache_read_input_tokens":91869,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2086},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"73f8b682-f7c3-4174-8378-470a5c779326","uuid":"08b07933-49fa-4cb4-bf14-ddbf62e8c2a0","timestamp":"2026-08-02T13:04:18.156Z","request_id":"req_011Cddy8FxCkkWfN3RMMv9v3"}
