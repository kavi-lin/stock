:.1f}%\")\n\nprint(\"\\n=== D. hot_zone_eval_derived distribution ===\")\nc=collections.Counter(th(r,'hot_zone_eval_derived') for r in dd)\nfor k,x in c.most_common(): print(f\"  {str(k):28} {x}\")\nq=[r for r in dd if th(r,'hot_zone_qualifying')]\nprint(f\"  hot_zone_qualifying=True: {len(q)}\")\n\nprint(\"\\n=== E. Rec 11 suppressed subset (win100 realized) ===\")\nsup=[r for r in dd if th(r,'hot_zone_eval_derived')=='suppressed_by_risk_flag']\nprint(f\" suppressed n={len(sup)}\")\nrets=[]\nfor r in sup:\n    tr=((r.get('reality_at_eval') or {}).get('ticker_reality') or {})\n    print(f\"  {r['decision_date']} {','.join(r['tickers']):8} score={dc(r,'final_score')} act={dc(r,'final_action')} regime={th(r,'macro_regime')} v={v(r)} ret={tr.get('return_pct')} runup={tr.get('max_runup_pct')} dd={tr.get('max_drawdown_pct')} wc={wc(r)}\")\n    if wc(r)==100 and tr.get('return_pct') is not None: rets.append(tr['return_pct'])\nif rets: print(f\"  win100 N={len(rets)} avg_ret={statistics.mean(rets):+.2f}% median={statistics.median(rets):+.2f}% pos={sum(1 for x in rets if x>0)}/{len(rets)}\")\nallr=[((r.get('reality_at_eval') or {}).get('ticker_reality') or {}).get('return_pct') for r in dd if wc(r)==100]\nallr=[x for x in allr if x is not None]\nprint(f\"  BOOK BASELINE win100 N={len(allr)} avg_ret={statistics.mean(allr):+.2f}% median={statistics.median(allr):+.2f}%\")\nEOF"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":24726,"cache_read_input_tokens":60610,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":24726},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"73f8b682-f7c3-4174-8378-470a5c779326","uuid":"3e682e98-b6a5-490b-9878-95ea2ceb2d00","timestamp":"2026-08-02T13:03:18.821Z","request_id":"req_011Cddy3syzspP92YGva7zez"}
