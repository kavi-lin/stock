    "report_polish": {"category": "narrative_synthesis", "output_tokens": 6000, "requires_web": false, "outage_policy": "deterministic_fallback"},

    "wind_reasoning": {"category": "external_tool_reasoning", "input_tokens": 100000, "output_tokens": 15000, "requires_web": false}
